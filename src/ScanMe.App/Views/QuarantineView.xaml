<UserControl x:Class="ScanMe.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Datenordner öffnen" Command="{Binding OpenDataDirCommand}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Quarantäne &amp; Verlauf" Style="{StaticResource H1}" />
                    <TextBlock Text="Alles, was ScanMe verändert hat, lässt sich hier rückgängig machen." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,10,0,0" Visibility="{Binding Message, Converter={StaticResource Vis}}" />

            <TextBlock Text="Quarantäne" Style="{StaticResource H2}" Margin="0,22,0,10" />
            <TextBlock Text="Keine Dateien in Quarantäne." Style="{StaticResource Muted}" Visibility="{Binding Items.Count, Converter={StaticResource InvVis}}" />
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Wiederherstellen" Margin="8,0,0,0"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource DangerButton}" Content="Endgültig löschen" Margin="8,0,0,0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding OriginalPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                        <Run Text="{Binding QuarantinedAt, StringFormat=g, Mode=OneWay}" /> · <Run Text="{Binding Reason, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="Wird beim nächsten Neustart entfernt (Datei war in Benutzung)." Foreground="{StaticResource MediumBrush}" FontSize="12"
                                               Visibility="{Binding PendingReboot, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Änderungsverlauf" Style="{StaticResource H2}" Margin="0,22,0,10" />
            <TextBlock Text="Noch keine Änderungen durchgeführt." Style="{StaticResource Muted}" Visibility="{Binding History.Count, Converter={StaticResource InvVis}}" />
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Rückgängig" VerticalAlignment="Center"
                                        Visibility="{Binding Undone, Converter={StaticResource InvVis}}"
                                        Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Text="rückgängig gemacht" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Visibility="{Binding Undone, Converter={StaticResource Vis}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding When, StringFormat=g}" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding DataDir, StringFormat=Datenordner: {0}}" Style="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
