<UserControl x:Class="ScanMe.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Einstellungen" Style="{StaticResource H1}" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Scan" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <CheckBox Content="Verdächtige Dateien zusätzlich von Microsoft Defender prüfen lassen" IsChecked="{Binding UseDefender}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Ereignisprotokolle auswerten für die letzten" VerticalAlignment="Center" />
                        <TextBox Width="60" Margin="8,0" Text="{Binding EventLogDays}" />
                        <TextBlock Text="Tage" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Zusätzliche Ordner für den Dateiscan (einer pro Zeile)" Style="{StaticResource Label}" Margin="0,14,0,4" />
                    <TextBox Text="{Binding ExtraPaths}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Scanner" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Scanners}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <CheckBox IsChecked="{Binding Enabled}">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </CheckBox>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Echtzeitüberwachung" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <CheckBox Content="Überwachung beim Start von ScanMe automatisch aktivieren" IsChecked="{Binding StartMonitorOnLaunch}" />
                    <CheckBox Content="Beim Schließen in den Infobereich (Tray) minimieren, solange die Überwachung läuft" IsChecked="{Binding MinimizeToTray}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Speichern" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
