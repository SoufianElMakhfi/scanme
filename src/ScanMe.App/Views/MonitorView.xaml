<UserControl x:Class="ScanMe.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Liste leeren" Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                <Button Command="{Binding ToggleCommand}" Padding="18,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Überwachung starten" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Überwachung stoppen" />
                                    <Setter Property="Background" Value="#3A1D22" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Echtzeitüberwachung" Style="{StaticResource H1}" />
                <TextBlock Text="Neue Prozesse, Autostarts, Dateien, Netzwerkverbindungen und Hosts-Änderungen werden sofort bewertet. Warnungen erscheinen auch als Windows-Benachrichtigung."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource InfoBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="16,0,0,0">
                    <Run Text="{Binding EventCount, Mode=OneWay}" /> Ereignisse · <Run Text="{Binding AlertCount, Mode=OneWay}" /> Warnungen
                </TextBlock>
            </StackPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Chip}" IsChecked="{Binding OnlyAlerts}" Content="Nur Auffälliges" HorizontalAlignment="Right" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CleanListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,8,12,8">
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="8,0,12,0" Background="{Binding Item.Severity, Converter={StaticResource SevBrush}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding KindText, Mode=OneWay}" /> · <Run Text="{Binding Item.Severity, Converter={StaticResource SevText}, Mode=OneWay}" /> · <Run Text="{Binding Item.Subtitle, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Ereignis auswählen" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource InvVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected.Item}" Visibility="{Binding Converter={StaticResource Vis}}">
                        <StackPanel>
                            <Border CornerRadius="5" Padding="9,2" HorizontalAlignment="Left" Background="{Binding Verdict, Converter={StaticResource VerdictBrush}}">
                                <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictText}}" FontSize="11" FontWeight="Bold" Foreground="#111" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <Border Margin="0,10,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1"
                                    Background="{Binding Verdict, Converter={StaticResource VerdictBg}}" BorderBrush="{Binding Verdict, Converter={StaticResource VerdictBrush}}">
                                <TextBlock Text="{Binding PlainSummary}" Style="{StaticResource Body}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Questions}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Body}" Margin="0,2"><Run Text="? " Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding ExecuteCommand}" Margin="0,0,8,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Body}" />
                            <TextBlock Text="INDIKATOREN" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Indicators}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Width="40" Text="{Binding Weight, Converter={StaticResource WeightText}}" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{Binding Weight, Converter={StaticResource WeightBrush}}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="DETAILS" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="11" />
                                            <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
