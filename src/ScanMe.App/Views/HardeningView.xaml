<UserControl x:Class="ScanMe.App.Views.HardeningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Stufen-Button: hervorgehoben, wenn diese Stufe aktiv ist -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyRecommendedCommand}" Padding="18,10" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Empfohlenen Schutz einrichten" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Riskante Regeln zuerst im Testmodus" Foreground="#DDE6FF" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Schutz-Assistent" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" MaxWidth="820" HorizontalAlignment="Left"
                               Text="Angriffe verhindern ist besser als sie hinterher zu finden. Windows bringt dafür professionelle Schutzfunktionen mit, die in Firmen Standard und auf Privat-PCs meist ausgeschaltet sind. Regeln mit „Testmodus“ blockieren noch nichts, sondern zeigen unten, was sie blockiert hätten – so geht nichts kaputt." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Manipulationsschutz prüfen" Command="{Binding OpenDefenderSettingsCommand}"
                            ToolTip="Der Manipulationsschutz kann aus Sicherheitsgründen nur in Windows-Sicherheit selbst eingeschaltet werden." />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,4,0,0" Visibility="{Binding Message, Converter={StaticResource Vis}}" />
                        <TextBlock Text="Lade bzw. ändere Einstellungen …" Style="{StaticResource Muted}" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                        <TextBlock Text="Ohne Adminrechte können Einstellungen nur angezeigt, aber nicht geändert werden." Foreground="{StaticResource MediumBrush}"
                                   Visibility="{Binding IsElevated, Converter={StaticResource InvVis}}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Gruppen -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,22,0,0">
                            <TextBlock Text="{Binding Key}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="5" Padding="8,1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Background" Value="{StaticResource GoodBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsAudit}" Value="True"><Setter Property="Background" Value="{StaticResource MediumBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="Bold" Foreground="#111" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Plain}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                                                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0">
                                                        <Run Text="Schützt vor: " FontWeight="SemiBold" /><Run Text="{Binding Protects, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Border Margin="0,6,0,0" CornerRadius="6" Padding="10,6" Background="#3A3118"
                                                            Visibility="{Binding DevNote, Converter={StaticResource Vis}}">
                                                        <TextBlock Style="{StaticResource Body}" FontSize="12">
                                                            <Run Text="Für Entwickler: " FontWeight="SemiBold" Foreground="{StaticResource MediumBrush}" /><Run Text="{Binding DevNote, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock FontSize="11" Style="{StaticResource Muted}" Margin="0,6,0,0">
                                                        <Run Text="{Binding RecommendedText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding RebootNote, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ModeButton}" Content="Aus" Command="{Binding SetOffCommand}" />
                                                    <Button Style="{StaticResource ModeButton}" Content="Testmodus" Command="{Binding SetAuditCommand}"
                                                            Visibility="{Binding SupportsAudit, Converter={StaticResource Vis}}" />
                                                    <Button Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12" Content="Aktiv" Command="{Binding SetOnCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Testmodus-Auswertung -->
            <TextBlock Text="Testmodus: Was wäre blockiert worden? (14 Tage)" Style="{StaticResource H2}" Margin="0,26,0,6" />
            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"
                       Text="Stehen hier nach einigen Tagen nur Programme, die Sie nicht brauchen oder nicht kennen, können Sie die Regel bedenkenlos auf „Aktiv“ stellen. Steht dort ein Werkzeug, das Sie täglich nutzen (z. B. node.exe, python.exe, Ihr Compiler), lassen Sie die Regel im Testmodus." />
            <TextBlock Text="Noch keine Einträge – entweder ist noch keine Regel im Testmodus, oder bisher wäre nichts blockiert worden. 👍" Style="{StaticResource Muted}"
                       Visibility="{Binding Hits.Count, Converter={StaticResource InvVis}}" />
            <ItemsControl ItemsSource="{Binding Hits}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding When, StringFormat=g, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Rule, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                    <Run Text="{Binding Process, Mode=OneWay}" /><Run Text="  →  " /><Run Text="{Binding Target, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
