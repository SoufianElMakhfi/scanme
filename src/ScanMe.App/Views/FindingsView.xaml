<UserControl x:Class="ScanMe.App.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Aktionsbutton: veraendernde Aktionen rot umrandet -->
        <DataTemplate x:Key="ActionButton">
            <Button Content="{Binding Label}" Command="{Binding ExecuteCommand}" Margin="0,0,8,8">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="Background" Value="#3A1D22" />
                                <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}" />
                                <Setter Property="Foreground" Value="#FFB3B6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel /></ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Bericht exportieren" Command="{Binding ExportHtmlCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Funde" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                    <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" angezeigt · Oben steht, was Sie tun sollten – ganz unten die Technik für Fortgeschrittene" />
                </TextBlock>
                <TextBlock Text="{Binding ExportMessage}" Foreground="{StaticResource GoodBrush}" Margin="0,4,0,0"
                           Visibility="{Binding ExportMessage, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DockPanel>

        <!-- Filter nach Ampel -->
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Suche in Titel, Pfad, Details" />
            <ComboBox DockPanel.Dock="Right" Width="200" Margin="0,0,10,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
            <WrapPanel VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowAct}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource CriticalBrush}" /> Handeln</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowCheck}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource MediumBrush}" /> Kurz prüfen</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowHarmless}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource GoodBrush}" /> Wahrscheinlich harmlos</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowInfo}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource InfoBrush}" /> Info</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowIgnored}" Content="Bekannt / ignoriert" />
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Liste ===== -->
            <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource CleanList}"
                     ItemContainerStyle="{StaticResource CleanListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,10,12,10">
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="8,0,12,0"
                                    Background="{Binding Verdict, Converter={StaticResource VerdictBrush}}" />
                            <Border DockPanel.Dock="Right" CornerRadius="5" Padding="7,1" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Background="{Binding Verdict, Converter={StaticResource VerdictBrush}}">
                                <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictText}}" FontSize="10" FontWeight="Bold" Foreground="#111" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Category, Converter={StaticResource CatText}}" Style="{StaticResource Label}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===== Detail ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Text="Fund auswählen, um die Einschätzung zu sehen." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource InvVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedItem}"
                                  Visibility="{Binding Converter={StaticResource Vis}}">
                        <StackPanel Margin="22">
                            <!-- Kopf -->
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="5" Padding="10,3" Background="{Binding Verdict, Converter={StaticResource VerdictBrush}}">
                                    <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictText}}" FontSize="12" FontWeight="Bold" Foreground="#111" />
                                </Border>
                                <TextBlock Text="{Binding Category, Converter={StaticResource CatText}}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <Border CornerRadius="5" Padding="8,2" Margin="10,0,0,0" Background="#183526" Visibility="{Binding IsProtected, Converter={StaticResource Vis}}">
                                    <TextBlock Text="🛡 Windows-Bestandteil – wird nie gelöscht" FontSize="11" Foreground="{StaticResource GoodBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="20" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <!-- 1. Einschaetzung -->
                            <Border Margin="0,14,0,0" CornerRadius="8" Padding="16,14" BorderThickness="1"
                                    Background="{Binding Verdict, Converter={StaticResource VerdictBg}}"
                                    BorderBrush="{Binding Verdict, Converter={StaticResource VerdictBrush}}">
                                <StackPanel>
                                    <TextBlock Text="UNSERE EINSCHÄTZUNG" Style="{StaticResource Label}" Foreground="{Binding Verdict, Converter={StaticResource VerdictBrush}}" />
                                    <TextBlock Text="{Binding PlainSummary}" Style="{StaticResource Body}" FontSize="14" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 2. Fragen an den Nutzer -->
                            <Border Margin="0,12,0,0" CornerRadius="8" Padding="16,14" Background="{StaticResource Surface2Brush}"
                                    Visibility="{Binding HasQuestions, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="NUR SIE KÖNNEN DAS BEANTWORTEN" Style="{StaticResource Label}" />
                                    <ItemsControl ItemsSource="{Binding Questions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Left" Text="?" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" Width="16" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Command="{Binding KnowItCommand}" Margin="0,0,8,0" Padding="14,8">
                                            <TextBlock Text="✔  Ja, kenne ich / war ich" />
                                        </Button>
                                        <Button Command="{Binding DoNotKnowCommand}" Style="{StaticResource DangerButton}" Padding="14,8">
                                            <TextBlock Text="✖  Nein / weiß nicht – was tun?" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 3. Konkrete Schritte -->
                            <Border Margin="0,12,0,0" CornerRadius="8" Padding="16,14" Background="#16233A" BorderBrush="#27406A" BorderThickness="1"
                                    Visibility="{Binding ShowSteps, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="DAS SOLLTEN SIE JETZT TUN" Style="{StaticResource Label}" Foreground="{StaticResource AccentHoverBrush}" />
                                    <TextBlock Text="{Binding IfUnknown}" Style="{StaticResource Body}" Margin="0,6,0,10" />
                                    <ItemsControl ItemsSource="{Binding PrimaryActions}" ItemTemplate="{StaticResource ActionButton}" ItemsPanel="{StaticResource Wrap}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Wird ausgeführt …" Style="{StaticResource Muted}" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ActionMessage}" Margin="0,8,0,0" Visibility="{Binding ActionMessage, Converter={StaticResource Vis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActionSucceeded}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 4. Technik (eingeklappt) -->
                            <Expander Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="Technische Details für Fortgeschrittene" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                        <Run Text="Technischer Schweregrad: " /><Run Text="{Binding Severity, Converter={StaticResource SevText}, Mode=OneWay}" /><Run Text=" · Score " /><Run Text="{Binding Score, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Text="WAS WURDE GEFUNDEN" Style="{StaticResource Label}" Margin="0,12,0,4" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" />

                                    <TextBlock Text="HINTERGRUND" Style="{StaticResource Label}" Margin="0,12,0,4" Visibility="{Binding Explanation, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" Visibility="{Binding Explanation, Converter={StaticResource Vis}}" />

                                    <TextBlock Text="EMPFEHLUNG (TECHNISCH)" Style="{StaticResource Label}" Margin="0,12,0,4" Visibility="{Binding Recommendation, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Body}" Visibility="{Binding Recommendation, Converter={StaticResource Vis}}" />

                                    <TextBlock Text="ALLE AKTIONEN" Style="{StaticResource Label}" Margin="0,12,0,6" Visibility="{Binding Actions.Count, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionButton}" ItemsPanel="{StaticResource Wrap}" />
                                    <WrapPanel>
                                        <CheckBox Content="Ignorieren (bekannt / gewollt)" IsChecked="{Binding IsIgnored}" Margin="0,0,16,0" />
                                        <Button Style="{StaticResource GhostButton}" Content="Details kopieren" Command="{Binding CopyDetailsCommand}" Padding="6,4" />
                                    </WrapPanel>

                                    <TextBlock Text="BEWEISE / INDIKATOREN (+ erhöht, − senkt das Risiko)" Style="{StaticResource Label}" Margin="0,12,0,6" />
                                    <ItemsControl ItemsSource="{Binding Indicators}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Left" Width="44" Text="{Binding Weight, Converter={StaticResource WeightText}}" FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{Binding Weight, Converter={StaticResource WeightBrush}}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="TECHNISCHE DETAILS" Style="{StaticResource Label}" Margin="0,12,0,6" Visibility="{Binding Details.Count, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"
                                                             FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
