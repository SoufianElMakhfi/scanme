<UserControl x:Class="ScanMe.App.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Bericht exportieren" Command="{Binding ExportHtmlCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Funde" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                    <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" angezeigt · Klick auf einen Fund zeigt Erklärung, Beweise und Gegenmaßnahmen" />
                </TextBlock>
                <TextBlock Text="{Binding ExportMessage}" Foreground="{StaticResource GoodBrush}" Margin="0,4,0,0"
                           Visibility="{Binding ExportMessage, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DockPanel>

        <!-- Filter -->
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <TextBox DockPanel.Dock="Right" Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Suche in Titel, Pfad, Details" />
            <ComboBox DockPanel.Dock="Right" Width="210" Margin="0,0,10,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
            <WrapPanel VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowCritical}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource CriticalBrush}" /> Kritisch</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowHigh}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource HighBrush}" /> Hoch</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowMedium}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource MediumBrush}" /> Mittel</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowLow}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource LowBrush}" /> Niedrig</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowInfo}">
                    <TextBlock><Run Text="●" Foreground="{StaticResource InfoBrush}" /> Info</TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowIgnored}" Content="Ignorierte" />
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Liste -->
            <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource CleanList}"
                     ItemContainerStyle="{StaticResource CleanListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,10,12,10">
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="8,0,12,0"
                                    Background="{Binding Severity, Converter={StaticResource SevBrush}}" />
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border CornerRadius="5" Padding="7,1" Background="{Binding Severity, Converter={StaticResource SevBrush}}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SevText}}" FontSize="10" FontWeight="Bold" Foreground="#111" />
                                </Border>
                                <TextBlock Text="{Binding Score, StringFormat=Score {0}}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Category, Converter={StaticResource CatText}}" Style="{StaticResource Label}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Text="Fund auswählen, um Details zu sehen." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource InvVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedItem}"
                                  Visibility="{Binding Converter={StaticResource Vis}}">
                        <StackPanel Margin="22">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="5" Padding="9,2" Background="{Binding Severity, Converter={StaticResource SevBrush}}">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#111">
                                        <Run Text="{Binding Severity, Converter={StaticResource SevText}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Score, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Category, Converter={StaticResource CatText}}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <Border CornerRadius="5" Padding="8,2" Margin="10,0,0,0" Background="#183526" Visibility="{Binding IsProtected, Converter={StaticResource Vis}}">
                                    <TextBlock Text="🛡 Windows-Komponente – geschützt" FontSize="11" Foreground="{StaticResource GoodBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="20" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <TextBlock Text="WAS WURDE GEFUNDEN" Style="{StaticResource Label}" Margin="0,18,0,4" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" />

                            <TextBlock Text="WARUM IST DAS WICHTIG" Style="{StaticResource Label}" Margin="0,16,0,4" Visibility="{Binding Explanation, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" Visibility="{Binding Explanation, Converter={StaticResource Vis}}" />

                            <Border Margin="0,16,0,0" CornerRadius="8" Padding="14,12" Background="#16233A" BorderBrush="#27406A" BorderThickness="1"
                                    Visibility="{Binding Recommendation, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="EMPFEHLUNG" Style="{StaticResource Label}" Foreground="{StaticResource AccentHoverBrush}" />
                                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Aktionen -->
                            <TextBlock Text="AKTIONEN" Style="{StaticResource Label}" Margin="0,18,0,6" Visibility="{Binding Actions.Count, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding ExecuteCommand}" Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                                            <Setter Property="Background" Value="#3A1D22" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}" />
                                                            <Setter Property="Foreground" Value="#FFB3B6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <CheckBox Content="Ignorieren (bekannt / gewollt)" IsChecked="{Binding IsIgnored}" Margin="0,0,16,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Details kopieren" Command="{Binding CopyDetailsCommand}" Padding="6,4" />
                            </WrapPanel>
                            <TextBlock Text="Wird ausgeführt …" Style="{StaticResource Muted}" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ActionMessage}" Margin="0,6,0,0" Visibility="{Binding ActionMessage, Converter={StaticResource Vis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActionSucceeded}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Indikatoren -->
                            <TextBlock Text="BEWEISE / INDIKATOREN" Style="{StaticResource Label}" Margin="0,18,0,6" />
                            <ItemsControl ItemsSource="{Binding Indicators}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Width="44" Text="{Binding Weight, Converter={StaticResource WeightText}}" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{Binding Weight, Converter={StaticResource WeightBrush}}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Details -->
                            <TextBlock Text="TECHNISCHE DETAILS" Style="{StaticResource Label}" Margin="0,18,0,6" Visibility="{Binding Details.Count, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="12" />
                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
