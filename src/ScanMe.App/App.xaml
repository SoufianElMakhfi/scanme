<Application x:Class="ScanMe.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScanMe.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:SeverityToBrushConverter x:Key="SevBrush" />
            <local:SeverityTextConverter x:Key="SevText" />
            <local:VerdictToBrushConverter x:Key="VerdictBrush" />
            <local:VerdictTextConverter x:Key="VerdictText" />
            <local:VerdictToBackgroundConverter x:Key="VerdictBg" />
            <local:CheckResultToBrushConverter x:Key="CheckBrush" />
            <local:CategoryTextConverter x:Key="CatText" />
            <local:HealthToBrushConverter x:Key="HealthBrush" />
            <local:BoolToVisibilityConverter x:Key="Vis" />
            <local:BoolToVisibilityConverter x:Key="InvVis" Invert="True" />
            <local:WeightToBrushConverter x:Key="WeightBrush" />
            <local:WeightTextConverter x:Key="WeightText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
